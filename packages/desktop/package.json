{
  "name": "@backspace/desktop",
  "version": "1.32.7",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Tavvit",
  "author": {
    "name": "Tavvit"
  },
  "homepage": "https://tavvit.com",
  "main": "dist/main.js",
  "desktopName": "de.hashhive.orbit.desktop",
  "scripts": {
    "build:ts": "tsc",
    "dev": "tsc && electron .",
    "build": "tsc && electron-builder --win --x64",
    "clean": "rm -rf dist dist-electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-rebuild -f -w uiohook-napi || node -e \"console.warn('[desktop] uiohook-napi native rebuild skipped - needs build tools (make, g++, python3). Only required to RUN the desktop app; the server, web client, and Docker image are unaffected.')\""
  },
  "dependencies": {
    "dbus-next": "0.10.2",
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "optionalDependencies": {
    "@vencord/venmic": "7.2.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
